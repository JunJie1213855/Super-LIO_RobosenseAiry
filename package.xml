<?xml version="1.0"?>
<package format="3">
  <name>super_lio_slam</name>
  <version>2.0.0</version>
  <description>Super-LIO with online STD loop detection, ICP verification, and pose graph optimization.</description>
  <maintainer email="lswang@mail.ecust.edu.cn">LS.Wang</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>livox_ros_driver2</depend>
  <depend>tf2_ros</depend>
  <depend>eigen3</depend>

  <build_depend>libpcl-dev</build_depend>
  <build_depend>libceres-dev</build_depend>
  <build_depend>libgtsam-dev</build_depend>
  <build_depend>libgoogle-glog-dev</build_depend>
  <build_depend>libgflags-dev</build_depend>
  <build_depend>libomp-dev</build_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
